// Cloudflare Workers (static assets): chỉ đưa thư mục public/ lên mạng.
// Cloudflare tự chạy "npx wrangler deploy" mỗi lần push nhánh main.
{
  "name": "nhat-ky-ba-nhat",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,      // bật link nhat-ky-ba-nhat.<tài khoản>.workers.dev
  "preview_urls": false,    // chỉ một link chính thức
  "assets": {
    "directory": "./public"
  }
}
